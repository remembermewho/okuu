# Скопируйте в .env и не коммитьте .env в git
DATABASE_URL=postgres://okuu:okuu_dev_password@localhost:5433/okuu?sslmode=disable
HTTP_ADDR=:8080
APP_ENV=dev
# Разрешённый Origin для POST/PUT/PATCH/DELETE (CSRF). В dev по умолчанию http://localhost:5173 (Vite).
APP_ORIGIN=http://localhost:5173
# Ключ шифрования (AES-GCM) для ключей Finik: 32+ случайных байта в base64. Сгенерировать: openssl rand -base64 32
ENCRYPTION_KEY=
# Telegram-бот для родителей. Без токена бот выключен (приглашения родителей отдают 409).
# Токен — от @BotFather; в логи и ответы API он не попадает.
TELEGRAM_BOT_TOKEN=
# Имя бота без @ — для ссылок t.me/<имя>?start=<токен>
TELEGRAM_BOT_USERNAME=
# off | polling (dev, по умолчанию с токеном) | webhook (prod, по умолчанию в APP_ENV=prod)
TELEGRAM_MODE=
# Для webhook: 16–256 символов A-Z a-z 0-9 _ -. Вебхук: APP_ORIGIN/webhooks/telegram/<секрет>.
# Сгенерировать: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Онлайн-оплата Finik. Пока провайдер — заглушка (API Finik не известен): держите false,
# тогда страница оплаты показывает реквизиты центра, а оплату отмечает администратор.
FINIK_ENABLED=false
FINIK_API_KEY=
