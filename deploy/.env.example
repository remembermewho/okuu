# Прод: скопируйте в deploy/.env на сервере (chmod 600) и заполните. В git не коммитить.
# Пароли и секреты — без спецсимволов URL (берите hex): openssl rand -hex 24

# Домены и e-mail для Let's Encrypt: приложение и лендинг (у обоих — DNS A-запись на этот сервер)
APP_DOMAIN=app.okuu.kg
LANDING_DOMAIN=okuu.kg
ACME_EMAIL=admin@okuu.kg

# PostgreSQL (в контейнере, наружу не открыт)
POSTGRES_DB=okuu
POSTGRES_USER=okuu
POSTGRES_PASSWORD=

# Приложение (APP_ENV=prod, HTTP_ADDR, DATABASE_URL и TRUSTED_PROXIES задаёт docker-compose.prod.yml)
APP_ORIGIN=https://app.okuu.kg
# 32+ случайных байта в base64: openssl rand -base64 32
ENCRYPTION_KEY=

# Telegram-бот (в prod обязателен, режим — webhook)
TELEGRAM_MODE=webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Служебный чат для алертов (id группы, отрицательное число). Пусто — алерты только в лог.
ALERT_TELEGRAM_CHAT_ID=

# Языки бота: ru (всё по-русски) или ru,ky — когда кыргызские тексты проверит носитель языка
BOT_LANGUAGES=ru

# Регистрация центров: invite (по умолчанию — только по ссылке из панели суперадмина), approval (заявка
# ждёт одобрения), open (свободно; в prod — только если задать явно)
REGISTRATION_MODE=invite
# Номер поддержки для кнопки «Написать в WhatsApp» на закрытой регистрации и экранах статуса центра
SUPPORT_WHATSAPP=

# Finik — пока заглушка, держите false
FINIK_ENABLED=false
FINIK_API_KEY=

# Бэкапы (deploy/backup.sh)
BACKUP_DIR=/var/backups/okuu
