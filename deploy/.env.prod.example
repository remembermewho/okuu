# Прод: на сервере скопируйте в deploy/.env и заполните (пошагово — docs/DEPLOY.md):
#   cp deploy/.env.prod.example deploy/.env && chmod 600 deploy/.env
# deploy/.env в git не попадает (.gitignore). Секреты — только там, генерируйте их командами ниже,
# не придумывайте. Значение — без кавычек и пробелов вокруг «=».
#
# APP_ENV=prod, TELEGRAM_MODE=webhook, APP_ORIGIN (https://APP_DOMAIN), HTTP_ADDR, DATABASE_URL и
# TRUSTED_PROXIES задаёт deploy/docker-compose.prod.yml — здесь их не пишите (compose всё равно перекроет).

# --- Домены и Let's Encrypt ---
# DNS-записи A (и AAAA, если есть IPv6) обоих доменов → IP сервера. Без https:// и без / на конце.
# Домен приложения, например app.okuu.kg
APP_DOMAIN=
# Домен лендинга, например okuu.kg
LANDING_DOMAIN=
# E-mail для писем Let's Encrypt (истекающие сертификаты), например admin@okuu.kg
ACME_EMAIL=

# --- PostgreSQL (в контейнере, наружу не открыт) ---
POSTGRES_DB=okuu
POSTGRES_USER=okuu
# hex — без спецсимволов, их не надо экранировать в DATABASE_URL: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Приложение ---
# Ключ шифрования (32 байта в base64): openssl rand -base64 32
# Сохраните копию вне сервера (менеджер паролей): без него не расшифровать сохранённые ключи провайдера оплаты.
ENCRYPTION_KEY=

# --- Telegram-бот (в prod обязателен; режим webhook — вебхук ставится сам при старте) ---
# Боевой бот у @BotFather (не тот, что для разработки): токен вида 123456789:AA…
TELEGRAM_BOT_TOKEN=
# Имя бота без @, например okuu_bot
TELEGRAM_BOT_USERNAME=
# Секрет в адресе вебхука и в заголовке от Telegram (16–256 символов A-Z a-z 0-9 _ -): openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Служебный чат для алертов: id группы (отрицательное число, см. docs/DEPLOY.md). Пусто — алерты только в лог.
ALERT_TELEGRAM_CHAT_ID=

# Языки бота: ru — всё по-русски; ru,ky — когда кыргызские тексты проверит носитель языка
BOT_LANGUAGES=ru

# --- Регистрация и оплата ---
# Регистрация центров: invite — только по одноразовой ссылке (панель суперадмина или server admin registration-link)
REGISTRATION_MODE=invite
# Номер поддержки для кнопки «Написать в WhatsApp» (только цифры с кодом страны, например 996700123456)
SUPPORT_WHATSAPP=

# Онлайн-оплата по ссылке выключена до подключения Finik: родители платят по реквизитам центра
ONLINE_PAYMENTS_ENABLED=false
# Finik — пока заглушка: false (работает только вместе с ONLINE_PAYMENTS_ENABLED=true)
FINIK_ENABLED=false
FINIK_API_KEY=

# --- Бэкапы (deploy/backup.sh) ---
# Каталог для архивов pg_dump на сервере и сколько дней их хранить
BACKUP_DIR=/var/backups/okuu
KEEP_DAYS=14
